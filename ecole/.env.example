# ---------------------------------------------------------------------------
# Terminish École — variables d'environnement (production)
# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.
# ---------------------------------------------------------------------------

# Port d'écoute HTTP (le proxy inverse — Caddy/Nginx — s'occupe du HTTPS)
PORT=3000

# Dossier de la base SQLite. En Docker : /data (volume persistant).
TERMINISH_DATA_DIR=/data

# demo = jeu de données de démonstration (école + comptes de test)
# prod = aucun établissement de démo : seul le compte administrateur est créé
TERMINISH_SEED=prod

# Compte super administrateur créé au premier démarrage.
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est affiché une seule
# fois dans les journaux du conteneur : notez-le immédiatement.
ADMIN_EMAIL=admin@votre-domaine.tg
ADMIN_PASSWORD=

# Cookies de session marqués Secure (obligatoire derrière HTTPS)
COOKIE_SECURE=1

# --- Récupération du mot de passe par Gmail (chefs + super-admin) -----------
# URL publique exacte du site, HTTPS, sans /app ni slash final.
# Laisser vide désactive l'envoi ; les enseignants gardent la demande au chef.
APP_PUBLIC_URL=
# Adresse Gmail expéditrice et mot de passe D'APPLICATION Gmail (2FA nécessaire).
# Ne jamais utiliser le mot de passe habituel du compte ni publier le .env.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Notification à l'éditeur par API officielle WhatsApp Business ---------
# FACULTATIF : aucune alerte WhatsApp n'est envoyée sans les trois valeurs
# obligatoires ET un modèle approuvé de six champs (voir README.md).
# Mettre les vraies valeurs dans le .env PRIVÉ du serveur, jamais ici ni dans un chat.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_DESTINATION=
WHATSAPP_TEMPLATE_NAME=terminish_paiement
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_GRAPH_VERSION=v23.0

# --- Anciennes passerelles (webhooks des dossiers déjà initiés uniquement) --
# Aucune nouvelle initiation CinetPay/PayDunya n'est possible dans le parcours
# actuel ; l'éditeur autorise lui-même chaque nouveau paiement/reçu. Garder ces
# paramètres seulement si un ancien dossier en ligne est encore en attente.

# PayDunya (T-Money / Mixx, Flooz / Moov, cartes)
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# CinetPay (alternative)
CINETPAY_MODE=live
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# --- Images : Cloudinary (optionnel) ---------------------------------------
# Sans ces clés, les logos restent en base (aucun envoi externe).
# Avec ces clés, une copie optimisée est envoyée sur le CDN ; la data URL reste
# enregistrée en base et sert de repli si le CDN est injoignable.
#   bash deploy/alwaysdata/cloudinary.sh --configurer
#   bash deploy/alwaysdata/cloudinary.sh --verifier
#   bash deploy/alwaysdata/cloudinary.sh --tester
# (gratuit, sans carte : https://cloudinary.com/users/register_free)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier racine sur le compte (défaut : terminish)
CLOUDINARY_FOLDER=terminish
# ou, en une seule ligne :
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Stockage externe des fichiers (signatures, logos) ---------------------
# Ordre d'essai des fournisseurs ; « local » est toujours ajouté en dernier
# (repli sur le disque, dossier data/media servi sous /media/...).
STORAGE_PROVIDERS=cloudinary,local

# Plusieurs comptes Cloudinary (rotation automatique par établissement).
# Séparateur : « ; » entre les comptes, « | » entre nom, clé et secret.
# CLOUDINARY_ACCOUNTS=cloud1|key1|secret1;cloud2|key2|secret2

# Google Drive : compte de service + dossier partagé avec son e-mail.
# GOOGLE_DRIVE_SA_JSON=/chemin/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=1AbC...

# MEGA via rclone (25 Go gratuits, aucune API Node fiable).
#   bash deploy/alwaysdata/rclone.sh --installer   → ~/bin/rclone
#   bash deploy/alwaysdata/rclone.sh --configurer  → remote « mega » + .env
# RCLONE_BIN=/home/COMPTE/bin/rclone     (ou simplement « rclone » si dans le PATH)
# MEGA_RCLONE_REMOTE=mega:Terminish
# STORAGE_PROVIDERS=mega,local
#
# Diagnostic : npm run stockage   |   npm run stockage -- --test mega
# Détail : STOCKAGE-EXTERNE.md

# --- Interface servie par un autre domaine (Firebase Hosting) -------------
# À renseigner UNIQUEMENT si l'interface et l'API sont sur deux domaines.
# CORS_ORIGIN=https://mon-ecole.web.app,https://mon-ecole.firebaseapp.com
